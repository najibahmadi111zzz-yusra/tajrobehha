<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- اجازه نمایش اعلان در Android 13 و بالاتر -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".TajroApplication"
        android:theme="@style/AppTheme"
        android:label="تجربه‌ها"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher">

        <!-- قفل امنیتی برنامه -->
        <activity
            android:name=".AppLockActivity"
            android:exported="false" />

        <activity
            android:name=".AIActivity"
            android:exported="false" />

        <activity
            android:name=".ChatActivity"
            android:exported="false" />

        <activity
            android:name=".AccountActivity"
            android:exported="false" />

        <activity
            android:name=".EditExperienceActivity"
            android:exported="false" />

        <activity
            android:name=".ExperienceListActivity"
            android:exported="false" />

        <activity
            android:name=".AddExperienceActivity"
            android:exported="false" />

        <activity
            android:name=".VoiceActivity"
            android:exported="false" />
<activity
    android:name=".BallGameActivity"
    android:exported="false" />
        
        <activity
            android:name=".ExchangeActivity"
            android:exported="false" />

        <activity
            android:name=".VaultActivity"
            android:exported="false" />

        <!-- تنظیمات -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- دریافت اعلان‌های Firebase -->
        <service
            android:name=".TajroFirebaseMessagingService"
            android:exported="false">

            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>

        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>
